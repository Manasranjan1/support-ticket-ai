# =============================================
# Server
# =============================================
PORT=3000
NODE_ENV=development

# =============================================
# Database (Supabase PostgreSQL)
# Get this from: Supabase Dashboard → Project Settings → Database → Connection String
# Use the "Session pooler" string (port 5432) for a persistent Node.js server.
# =============================================
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:5432/postgres

# =============================================
# AI Provider
# Set to "google" (default) or "openai"
# Only the keys for the selected provider are required.
# =============================================
AI_PROVIDER=google

# Google Gemini (used when AI_PROVIDER=google)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CHAT_MODEL=gemini-2.0-flash

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
